# =============================================================================
# ACS Backend - environment template
# Copy to .env and fill in real values. NEVER commit .env.
#   Windows PowerShell:  Copy-Item .env.example .env
#   bash:                cp .env.example .env
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/acs
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/acs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/acs

# --- Tokens ----------------------------------------------------------------
# Generate a strong secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Cookies (refresh token transport) -------------------------------------
# COOKIE_SECURE must be true in production (HTTPS only).
# Cross-site frontend (different domain) => COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security --------------------------------------------------------------
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=15
GLOBAL_RATE_LIMIT_MAX=500

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Seed (npm run seed) ---------------------------------------------------
SEED_ADMIN_NAME=ACS Admin
SEED_ADMIN_EMAIL=admin@acs.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Set to true to also create demo contestant/judge accounts (dev only)
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=Passw0rd!2026
